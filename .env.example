# CineMatch Environment Configuration Example
# Copy this file to .env and configure your values

NODE_ENV=development
PORT=5000

# Client Application URLs (for CORS)
CLIENT_URL=http://localhost:5173
WEB_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/cinematch

# JWT Authentication
JWT_SECRET=super_secret_cinematch_jwt_dev_key_do_not_use_in_prod
JWT_EXPIRES_IN=7d

# Movie Provider (Optional: The system provides rich offline seed data if no TMDB API key is specified)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# AI & LLM Providers (Optional: Deterministic rule-based NLP & local TF-IDF vectorizers are used if omitted)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_API_KEY=
VECTOR_DB_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
