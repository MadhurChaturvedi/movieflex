{
  "name": "cinematch-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CineMatch — Intelligent Movie Discovery & Recommendation Platform",
  "workspaces": [
    "packages/*",
    "server",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:mobile": "npm --workspace=apps/mobile run start",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "seed": "npm --workspace=server run seed"
  },
  "keywords": [
    "cinematch",
    "movies",
    "recommendations",
    "ai",
    "rag",
    "semantic-search",
    "react",
    "react-native",
    "express",
    "mongodb"
  ],
  "author": "CineMatch Engineering Team",
  "license": "MIT"
}
